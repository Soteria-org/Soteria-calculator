<?php
// Copy to config.local.php (gitignored — never commit real credentials)
// and fill in. config.php loads this automatically if it exists.
//
// This is the file that matters for InfinityFree (or any shared host
// where you can't reliably set real PHP environment variables): put your
// actual DB credentials here, then upload config.local.php to the server
// yourself — or better, let the deploy workflow generate it from GitHub
// Secrets so the real credentials never sit in your local filesystem or
// git history. See backend/README.md → "Hosting on InfinityFree".

// InfinityFree's phpMyAdmin shows these on your database's page. The
// hostname is NOT "localhost" — it's something like sqlXXX.infinityfree.com.
// Database and username are both auto-prefixed by InfinityFree, e.g.
// "if0_12345678_soteria_calculator" / "if0_12345678".
define('SOTERIA_DB_HOST', 'sqlXXX.infinityfree.com');
define('SOTERIA_DB_NAME', 'if0_XXXXXXXX_soteria_calculator');
define('SOTERIA_DB_USER', 'if0_XXXXXXXX');
define('SOTERIA_DB_PASS', 'your-db-password');

// Once you know the exact URL Vercel serves the frontend from, lock CORS
// to it instead of leaving it open to any site:
// define('SOTERIA_ALLOWED_ORIGIN', 'https://soteria-calculator.vercel.app');

// Required before migrate.php will run. Generate with `openssl rand -hex 20`
// (or anything else long and random) — treat it like a password, since
// anyone who has it can run schema.sql against your live database.
define('SOTERIA_MIGRATION_TOKEN', 'generate-a-random-string-here');

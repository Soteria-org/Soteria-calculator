# Copy to .env.local (gitignored) and fill in.
#
# Where the records API (backend/ — PHP + MySQL) is running. Without this
# set, the calculator still works fully (scope → price → breakdown), but
# "Save quote" and everything under /projects (invoices, payments,
# receipts) is disabled.
#
# Local XAMPP default, if you copied backend/ to htdocs/soteria-api:
NEXT_PUBLIC_API_BASE_URL=http://Soteria-calc.free.nf/soteria-api
